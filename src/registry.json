{
  "version": "1.2.662-beta",
  "apps": {
    "aider": {
      "name": "Aider",
      "description": "AI pair programming in your terminal",
      "author": "Paul Gauthier",
      "install_mode": "proot",
      "install_cmd": "pip install --break-system-packages aider-chat",
      "update_cmd": "pip install --upgrade --break-system-packages aider-chat",
      "uninstall_cmd": "pip uninstall -y aider-chat",
      "executable": "aider",
      "optional_env_vars": [
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "ALL_PROXY"
      ],
      "version_cmd": "aider --version",
      "latest": {
        "source": "pypi",
        "package": "aider-chat"
      },
      "version": "0.86.2"
    },
    "mimo": {
      "name": "MiMo Code",
      "supported_arches": [
        "arm64",
        "x86_64"
      ],
      "default_command_arch": "arm64",
      "install_cmd_by_arch": {
        "x86_64": "curl -fL --retry 3 --retry-delay 2 https://github.com/XiaomiMiMo/MiMo-Code/releases/latest/download/mimocode-linux-x64-baseline.tar.gz -o /tmp/mimo.tar.gz && tar -xzf /tmp/mimo.tar.gz -C /usr/local/bin && rm -f /tmp/mimo.tar.gz"
      },
      "update_cmd_by_arch": {
        "x86_64": "curl -fL --retry 3 --retry-delay 2 https://github.com/XiaomiMiMo/MiMo-Code/releases/latest/download/mimocode-linux-x64-baseline.tar.gz -o /tmp/mimo.tar.gz && tar -xzf /tmp/mimo.tar.gz -C /usr/local/bin && rm -f /tmp/mimo.tar.gz"
      },
      "description": "Terminal AI agent tailored for Android/Proot",
      "author": "XiaomiMiMo",
      "install_mode": "proot",
      "install_cmd": "curl -fL --retry 3 --retry-delay 2 https://github.com/XiaomiMiMo/MiMo-Code/releases/latest/download/mimocode-linux-arm64.tar.gz -o /tmp/mimo.tar.gz && tar -xzf /tmp/mimo.tar.gz -C /usr/local/bin && rm -f /tmp/mimo.tar.gz",
      "update_cmd": "curl -fL --retry 3 --retry-delay 2 https://github.com/XiaomiMiMo/MiMo-Code/releases/latest/download/mimocode-linux-arm64.tar.gz -o /tmp/mimo.tar.gz && tar -xzf /tmp/mimo.tar.gz -C /usr/local/bin && rm -f /tmp/mimo.tar.gz",
      "uninstall_cmd": "rm -f /usr/local/bin/mimo",
      "executable": "mimo",
      "optional_env_vars": [
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "ALL_PROXY"
      ],
      "version_cmd": "mimo --version",
      "latest": {
        "source": "github",
        "repo": "XiaomiMiMo/MiMo-Code"
      },
      "version": "0.1.14"
    },
    "agy": {
      "name": "Antigravity CLI",
      "supported_arches": [
        "arm64",
        "x86_64"
      ],
      "description": "Google's powerful terminal agent",
      "author": "Google",
      "install_mode": "proot",
      "install_method": "pipe_script",
      "installer_url": "https://antigravity.google/cli/install.sh",
      "installer_args": "--dir /usr/local/bin",
      "installer_script_env": {},
      "install_cmd": "curl -sL https://antigravity.google/cli/install.sh | bash -s -- --dir /usr/local/bin",
      "update_cmd": "agy update",
      "uninstall_cmd": "rm -f /usr/local/bin/agy /root/.local/bin/agy",
      "executable": "agy",
      "optional_env_vars": [
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "ALL_PROXY"
      ],
      "version_cmd": "agy --version",
      "latest": {
        "source": "json",
        "url": "https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/linux_arm64.json",
        "url_by_arch": {
          "arm64": "https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/linux_arm64.json",
          "x86_64": "https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/linux_amd64.json"
        },
        "path": "version",
        "note": "Official Antigravity release manifest (same endpoint the vendor installer reads)."
      },
      "version": "1.2.12"
    },
    "claude-code": {
      "name": "Claude Code",
      "supported_arches": [
        "arm64",
        "x86_64"
      ],
      "default_command_arch": "arm64",
      "install_cmd_by_arch": {
        "x86_64": "curl -fL --retry 3 --retry-delay 2 https://github.com/anthropics/claude-code/releases/latest/download/claude-linux-x64.tar.gz -o /tmp/claude-linux-x64.tar.gz && curl -fL --retry 3 --retry-delay 2 https://github.com/anthropics/claude-code/releases/latest/download/SHASUMS256.txt -o /tmp/SHASUMS256.txt && cd /tmp && sha256sum -c --ignore-missing SHASUMS256.txt && tar -xzf /tmp/claude-linux-x64.tar.gz -C /usr/local/bin && rm -f /tmp/claude-linux-x64.tar.gz /tmp/SHASUMS256.txt"
      },
      "update_cmd_by_arch": {
        "x86_64": "curl -fL --retry 3 --retry-delay 2 https://github.com/anthropics/claude-code/releases/latest/download/claude-linux-x64.tar.gz -o /tmp/claude-linux-x64.tar.gz && curl -fL --retry 3 --retry-delay 2 https://github.com/anthropics/claude-code/releases/latest/download/SHASUMS256.txt -o /tmp/SHASUMS256.txt && cd /tmp && sha256sum -c --ignore-missing SHASUMS256.txt && tar -xzf /tmp/claude-linux-x64.tar.gz -C /usr/local/bin && rm -f /tmp/claude-linux-x64.tar.gz /tmp/SHASUMS256.txt"
      },
      "description": "Anthropic's official terminal coding agent",
      "author": "Anthropic",
      "install_mode": "proot",
      "install_cmd": "curl -fL --retry 3 --retry-delay 2 https://github.com/anthropics/claude-code/releases/latest/download/claude-linux-arm64.tar.gz -o /tmp/claude-linux-arm64.tar.gz && curl -fL --retry 3 --retry-delay 2 https://github.com/anthropics/claude-code/releases/latest/download/SHASUMS256.txt -o /tmp/SHASUMS256.txt && cd /tmp && sha256sum -c --ignore-missing SHASUMS256.txt && tar -xzf /tmp/claude-linux-arm64.tar.gz -C /usr/local/bin && rm -f /tmp/claude-linux-arm64.tar.gz /tmp/SHASUMS256.txt",
      "update_cmd": "curl -fL --retry 3 --retry-delay 2 https://github.com/anthropics/claude-code/releases/latest/download/claude-linux-arm64.tar.gz -o /tmp/claude-linux-arm64.tar.gz && curl -fL --retry 3 --retry-delay 2 https://github.com/anthropics/claude-code/releases/latest/download/SHASUMS256.txt -o /tmp/SHASUMS256.txt && cd /tmp && sha256sum -c --ignore-missing SHASUMS256.txt && tar -xzf /tmp/claude-linux-arm64.tar.gz -C /usr/local/bin && rm -f /tmp/claude-linux-arm64.tar.gz /tmp/SHASUMS256.txt",
      "uninstall_cmd": "rm -f /usr/local/bin/claude",
      "env_vars": [],
      "optional_env_vars": [
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_AUTH_TOKEN",
        "ANTHROPIC_BASE_URL",
        "ANTHROPIC_MODEL",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "ALL_PROXY"
      ],
      "executable": "claude",
      "version_cmd": "claude --version",
      "latest": {
        "source": "github",
        "repo": "anthropics/claude-code"
      },
      "version": "2.1.283"
    },
