      "uninstall_cmd": "rm -f /usr/local/bin/grok /usr/local/bin/agent && rm -rf /root/.grok",
      "executable": "grok",
      "optional_env_vars": [
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "ALL_PROXY"
      ],
      "version_cmd": "grok --version",
      "latest": {
        "source": "text",
        "urls": [
          "https://x.ai/cli/stable",
          "https://storage.googleapis.com/grok-build-public-artifacts/cli/stable"
        ],
        "note": "Vendor channel pointer (x.ai/cli/<channel>) with the GCS mirror the installer falls back to."
      },
      "version": "1.0.41"
    },
    "dsh": {
      "name": "DeepSeek Harness",
      "supported_arches": [
        "arm64"
      ],
      "description": "DeepSeek's agent harness: dsh web UI, dsh headless \"task\"",
      "author": "DeepSeek AI",
      "install_mode": "proot",
      "proxy_mode": "direct",
      "requires_node": true,
      "patch_web_cookie": true,
      "integrity_pkg_json": "@deepseek-ai/dsh",
      "launch": {
        "mode": "web",
        "command": "dsh web --no-open",
        "label": "打开 Web UI"
      },
      "install_cmd": "npm install -g --registry=https://registry.npmmirror.com --allow-scripts=@deepseek-ai/dsh-subprocess-local,koffi,node-pty,@google/genai,protobufjs @deepseek-ai/dsh || npm install -g --allow-scripts=@deepseek-ai/dsh-subprocess-local,koffi,node-pty,@google/genai,protobufjs @deepseek-ai/dsh",
      "update_cmd": "npm install -g --registry=https://registry.npmmirror.com --allow-scripts=@deepseek-ai/dsh-subprocess-local,koffi,node-pty,@google/genai,protobufjs @deepseek-ai/dsh || npm install -g --allow-scripts=@deepseek-ai/dsh-subprocess-local,koffi,node-pty,@google/genai,protobufjs @deepseek-ai/dsh",
      "uninstall_cmd": "npm uninstall -g @deepseek-ai/dsh",
      "executable": "dsh",
      "env_vars": [],
      "optional_env_vars": [
        "DEEPSEEK_API_KEY",
        "DEEPSEEK_BASE_URL",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "ALL_PROXY"
      ],
      "version_cmd": "dsh --version",
      "latest": {
        "source": "npm",
        "package": "@deepseek-ai/dsh",
        "note": "Requires Node ^22.19 || >=24; AnCLI prepares Node 24 before installation. The wrapper uses direct network mode for dsh."
      },
      "version": "0.1.7-rc.2"
    },
    "codex-cli": {
      "name": "Codex CLI",
      "description": "OpenAI's coding agent for the terminal",
      "author": "OpenAI",
      "install_mode": "proot",
      "requires_node": true,
      "no_daemon": true,
      "sandbox_notice": "Android PRoot cannot provide Codex's default bubblewrap mount sandbox. After installation, start Codex, run /permissions, select Full Access, then retry shell commands. Full Access disables Codex's command sandbox; use only in a trusted workspace.",
      "install_cmd": "npm install -g @openai/codex",
      "update_cmd": "npm install -g @openai/codex@latest",
      "uninstall_cmd": "npm uninstall -g @openai/codex",
      "executable": "codex",
      "env_vars": [],
      "optional_env_vars": [
        "OPENAI_API_KEY",
        "OPENAI_BASE_URL",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "ALL_PROXY"
      ],
      "version_cmd": "codex --version",
      "latest": {
        "source": "npm",
        "package": "@openai/codex",
        "note": "Official OpenAI Codex CLI package. npm selects the Linux arm64 optional runtime inside the Android PRoot guest."
      },
      "version": "0.169.0"
    }
