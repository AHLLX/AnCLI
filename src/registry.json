      "install_cmd": "curl -fL --retry 3 --retry-delay 2 https://github.com/anomalyco/opencode/releases/latest/download/opencode-linux-arm64.tar.gz -o /tmp/opencode.tar.gz && tar -xzf /tmp/opencode.tar.gz -C /usr/local/bin && rm -f /tmp/opencode.tar.gz",
      "update_cmd": "curl -fL --retry 3 --retry-delay 2 https://github.com/anomalyco/opencode/releases/latest/download/opencode-linux-arm64.tar.gz -o /tmp/opencode.tar.gz && tar -xzf /tmp/opencode.tar.gz -C /usr/local/bin && rm -f /tmp/opencode.tar.gz",
